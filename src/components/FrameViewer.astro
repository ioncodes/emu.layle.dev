---
import Icon from "./Icon.astro";
---

<div
  id="frame-viewer"
  class="fixed inset-0 z-50 hidden bg-black/85"
  role="dialog"
  aria-modal="true"
  aria-label="Screenshot viewer"
>
  <div
    id="frame-viewer-scroll"
    class="flex h-full w-full items-center justify-center overflow-auto p-4"
  >
    <img
      id="frame-viewer-img"
      class="m-auto max-w-none select-none"
      draggable="false"
      alt=""
    />
  </div>
  <div
    id="frame-viewer-indicator"
    class="pointer-events-none absolute bottom-4 left-1/2 -translate-x-1/2 rounded bg-black/60 px-2 py-1 font-mono text-xs text-white"
  >
  </div>
  <button
    id="frame-viewer-close"
    class="absolute top-4 right-4 inline-flex items-center justify-center rounded bg-black/60 p-1.5 text-white hover:bg-black/80"
    aria-label="Close"
  >
    <Icon name="x" size={16} />
  </button>
</div>

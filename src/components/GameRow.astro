---
import type { GameRow } from "@/lib/meta";

interface Props {
  row: GameRow;
}

const { row } = Astro.props;
const hasFrames = row.frames.length > 0;
const hasDemo = row.demo !== null;
const hasMedia = hasFrames || hasDemo;

// The strip column grows to fill the row only when there are frames to scroll;
// with a demo alone it collapses so the row is just the demo with no trailing gap.
const colClass = [
  "strip-col flex flex-col",
  hasFrames ? "min-w-0 flex-1" : "",
]
  .join(" ")
  .trim();
---

<li
  class="game-row"
  data-game-id={row.game.game_id}
  data-title={row.game.game_title}
  data-has-frames={hasFrames}
  data-has-demo={hasDemo}
>
  <h2 class="flex items-baseline gap-3 text-sm">
    <span class="font-medium">{row.game.game_title}</span>
    <span class="font-mono text-xs text-neutral-500">{row.game.game_id}</span>
    {
      row.frames.length > 1 && (
        <span class="ml-auto text-xs text-neutral-500">{row.frames.length} frames</span>
      )
    }
  </h2>
  {
    hasMedia ? (
      <div class="mt-2 flex gap-2" style="min-height:140px">
        {hasDemo && <div class="demo-container flex shrink-0 items-start" />}
        <div class={colClass}>
          <div class="frames-container flex gap-2 overflow-x-auto" />
          {hasFrames && (
            <div class="frames-scrollbar" hidden>
              <div class="frames-scrollbar-thumb" />
            </div>
          )}
        </div>
      </div>
    ) : (
      <p class="mt-2 text-sm italic text-neutral-500">No screenshots available</p>
    )
  }
</li>

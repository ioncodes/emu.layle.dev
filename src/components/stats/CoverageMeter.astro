---
// A small dithered bar showing games with a screenshot vs games without, for a
// single commit. Filled portion uses the emulator's accent colour. No inline
// text; the percentage shows on hover.
//
// Hover visibility uses Tailwind's global `group-hover` utilities rather than a
// scoped `:hover` rule: Astro's scoped-style transform mangles an ancestor
// `:hover` descendant selector into a bare one, which would show the tip always.
interface Props {
  covered: number;
  total: number;
  accent: string;
}

const { covered, total, accent } = Astro.props;
const pct = total > 0 ? Math.round((covered / total) * 100) : 0;
const label = `${pct}% (${covered} of ${total} games with a screenshot)`;
---

<div class="group relative inline-block leading-none" role="img" aria-label={label}>
  <div class="coverage-meter">
    <div class="coverage-fill" style={`width:${pct}%; --accent:${accent};`}></div>
  </div>
  <span
    class="pointer-events-none absolute bottom-[calc(100%_+_6px)] left-1/2 -translate-x-1/2 whitespace-nowrap rounded border border-border bg-popover px-1.5 py-0.5 font-mono text-[11px] leading-tight text-popover-foreground opacity-0 transition-opacity duration-100 group-hover:opacity-100 group-focus-within:opacity-100"
  >
    {pct}%
  </span>
</div>

<style>
  .coverage-meter {
    position: relative;
    height: 12px;
    width: 180px;
    max-width: 45vw;
    overflow: hidden;
    border-radius: 3px;
    background-color: rgb(229 229 229); /* neutral-200 track */
  }

  .coverage-fill {
    height: 100%;
    background-color: var(--accent);
    /* Ordered-dither nod: a fine dot grid over the accent fill. */
    background-image: radial-gradient(rgba(0, 0, 0, 0.28) 0.5px, transparent 0.6px);
    background-size: 3px 3px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  @media (prefers-color-scheme: dark) {
    .coverage-meter {
      background-color: rgb(38 38 38); /* neutral-800 track */
    }

    .coverage-fill {
      /* Light dots in dark mode keep dark accents (e.g. navy) legible. */
      background-image: radial-gradient(rgba(255, 255, 255, 0.22) 0.5px, transparent 0.6px);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    }
  }
</style>

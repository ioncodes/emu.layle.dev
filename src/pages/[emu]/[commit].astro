---
import {
  countGamesWithFrames,
  formatTimestamp,
  getCommits,
  getEmulators,
  getGameRows,
  getSubmission,
} from "@/lib/meta";
import { siteConfig } from "../../../site.config";
import GameRow from "@/components/GameRow.astro";
import FrameViewer from "@/components/FrameViewer.astro";
import CommitNav from "@/components/CommitNav.astro";
import CompareNav from "@/components/CompareNav.astro";
import EmulatorTabs from "@/components/EmulatorTabs.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import CoverageMeter from "@/components/stats/CoverageMeter.astro";
import "../../styles/global.css";

export function getStaticPaths() {
  const paths: { params: { emu: string; commit: string } }[] = [];
  for (const emu of getEmulators()) {
    for (const sub of getCommits(emu.slug)) {
      paths.push({ params: { emu: emu.slug, commit: sub.commit_short } });
    }
  }
  return paths;
}

const { emu, commit } = Astro.params;
const allEmulators = getEmulators();
const emulator = allEmulators.find((e) => e.slug === emu);
const submission = getSubmission(emu!, commit!);
if (!emulator || !submission) {
  throw new Error(`no submission ${emu}/${commit}`);
}

const rows = getGameRows(emu!, commit!);
const allCommits = getCommits(emu!);
const commitUrl = emulator.commit_url_template.replace("{sha}", submission.commit);

// The demos-only matrix view and its toggle only exist when there are demos.
const screenshotsBase = siteConfig.screenshotsBaseUrl;
const demoRows = rows.filter((r) => r.demo);
const hasDemos = demoRows.length > 0;

const firstGameFrame = emulator.first_game_frame ?? 0;
const framesTotal = submission.screenshots.length;
const gamesTotal = submission.games.length;
const gamesWithFrames = countGamesWithFrames(submission, firstGameFrame);
const withFramesLabel = firstGameFrame > 0 ? "in-game" : "with screenshots";

const coverRow = rows.find((r) => r.frames.length > 0);
const cover = coverRow?.frames.at(-1);
const description = [
  `${gamesTotal} games · ${gamesWithFrames} ${withFramesLabel} · ${framesTotal} frames`,
  `${submission.commit_message} (${formatTimestamp(submission.commit_timestamp)})`,
].join("\n");

const ogImage = cover
  ? {
      url: `${siteConfig.screenshotsBaseUrl}/${cover.r2_key}`,
      width: cover.width,
      height: cover.height,
      alt: `${coverRow!.game.game_title} running on ${emulator.name} at ${submission.commit_short}`,
    }
  : null;

---

<!doctype html>
<html lang="en" class="bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
  <head>
    <HeadMeta
      title={`${emulator.name} / ${submission.commit_short}`}
      description={description}
      image={ogImage}
      accentColor={emulator.accent_color}
    />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <div class="border-b border-neutral-200 dark:border-neutral-800">
      <div class="mx-auto max-w-6xl px-6 py-4">
        <EmulatorTabs emulators={allEmulators} currentSlug={emu!} />
      </div>
    </div>

    <main class="mx-auto max-w-6xl px-6 py-8">
      <header class="mb-8 border-b border-neutral-200 pb-6 dark:border-neutral-800">
        <div class="flex flex-wrap items-center gap-4">
          <a
            href={commitUrl}
            class="font-mono text-sm text-neutral-600 hover:underline dark:text-neutral-400"
            target="_blank"
            rel="noreferrer"
          >
            {submission.commit_short}
          </a>
          <span class="font-mono text-xs text-neutral-500">{formatTimestamp(submission.commit_timestamp)}</span>
          <CommitNav emu={emu!} current={submission} allCommits={allCommits} />
          {allCommits.length > 1 && (
            <CompareNav emu={emu!} current={submission} allCommits={allCommits} />
          )}
          {hasDemos && (
            <div
              id="view-toggle"
              role="group"
              aria-label="View mode"
              class="inline-flex overflow-hidden rounded border border-neutral-300 dark:border-neutral-700"
            >
              <button
                type="button"
                data-view="list"
                aria-pressed="true"
                class="px-2.5 py-1 text-sm text-neutral-600 hover:bg-neutral-100 aria-pressed:bg-neutral-200 aria-pressed:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:aria-pressed:bg-neutral-800 dark:aria-pressed:text-neutral-100"
              >
                List
              </button>
              <button
                type="button"
                data-view="demos"
                aria-pressed="false"
                class="border-l border-neutral-300 px-2.5 py-1 text-sm text-neutral-600 hover:bg-neutral-100 aria-pressed:bg-neutral-200 aria-pressed:text-neutral-900 dark:border-neutral-700 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:aria-pressed:bg-neutral-800 dark:aria-pressed:text-neutral-100"
              >
                Demos
              </button>
            </div>
          )}
          <input
            id="game-filter"
            type="search"
            placeholder="Filter games..."
            aria-label="Filter games by title or id"
            class="ml-auto w-64 max-w-full rounded border border-neutral-300 bg-white px-3 py-1 text-sm outline-none focus:border-neutral-500 dark:border-neutral-700 dark:bg-neutral-900"
          />
        </div>
        <p class="mt-3 text-sm text-neutral-700 dark:text-neutral-300">
          {submission.commit_message}
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
          <p class="text-xs text-neutral-500">
            {gamesTotal} games, {gamesWithFrames} {withFramesLabel}, {framesTotal} frames
          </p>
          <CoverageMeter covered={gamesWithFrames} total={gamesTotal} accent={emulator.accent_color} />
        </div>
      </header>

      <ul id="games-list" class="space-y-10">
        {rows.map((row) => <GameRow row={row} />)}
      </ul>

      {hasDemos && (
        <div
          id="games-matrix"
          hidden
          class="grid gap-4"
          style="grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));"
        >
          {demoRows.map((r) => (
            <figure class="matrix-cell" data-game-id={r.game.game_id} data-title={r.game.game_title}>
              <img
                src={`${screenshotsBase}/${r.demo!.r2_key}`}
                width={r.demo!.width}
                height={r.demo!.height}
                loading="lazy"
                class="w-full cursor-pointer rounded border border-neutral-200 [image-rendering:pixelated] dark:border-neutral-800"
                alt={`${r.game.game_title} demo`}
              />
              <figcaption class="mt-1 truncate text-xs text-neutral-500" title={r.game.game_title}>
                {r.game.game_title}
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </main>

    <FrameViewer />

    <script
      is:inline
      type="application/json"
      id="commit-config"
      set:html={JSON.stringify({
        emu,
        commit: submission.commit_short,
        base: siteConfig.screenshotsBaseUrl,
      })}
    />
    <script>
      import "../../scripts/commit-view";
    </script>
  </body>
</html>

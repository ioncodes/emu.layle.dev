---
import { getEmulators } from "@/lib/meta";

export function getStaticPaths() {
  return getEmulators().map((e) => ({ params: { emu: e.slug } }));
}

const { emu } = Astro.params;
const emulator = getEmulators().find((e) => e.slug === emu);
if (!emulator) throw new Error(`no emulator ${emu}`);
---

<!doctype html>
<html lang="en" class="bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{emulator.name} / compare</title>
  </head>
  <body class="min-h-screen font-sans antialiased">
    <main class="mx-auto max-w-6xl px-6 py-8">
      <p class="text-sm text-neutral-500">
        Redirecting… <a href={`/${emu}`} class="underline">Back to {emulator.name}</a>
      </p>
    </main>

    <script define:vars={{ emu }}>
      const params = new URLSearchParams(window.location.search);
      const a = params.get("a");
      const b = params.get("b");

      if (a && b && a !== b) {
        window.location.replace(`/${emu}/compare/${encodeURIComponent(a)}/${encodeURIComponent(b)}`);
      } else {
        window.location.replace(`/${emu}`);
      }
    </script>
  </body>
</html>

---
import { getCommits, getEmulators } from "@/lib/meta";
import "../styles/global.css";

function iconUrl(slug: string, color: string): string {
  const [prefix, name] = slug.split(":");
  return `https://api.iconify.design/${prefix}/${name}.svg?color=${encodeURIComponent(color)}`;
}

const emulators = getEmulators().map((e) => ({
  ...e,
  hasCommits: getCommits(e.slug).length > 0,
  iconSrc: e.icon ? iconUrl(e.icon, e.accent_color) : null,
}));
---

<!doctype html>
<html lang="en" class="bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>emu.layle.dev</title>
  </head>
  <body class="min-h-screen font-sans antialiased">
    <main class="mx-auto max-w-3xl px-6 py-16">
      <h1 class="text-2xl font-semibold">emu.layle.dev</h1>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
        Per-commit screenshot snapshots for my emulators. Useful to track regressions and improvements over time.
      </p>

      <ul class="mt-10 space-y-3">
        {
          emulators.map((e) => (
            <li>
              <a
                href={e.hasCommits ? `/${e.slug}` : undefined}
                aria-disabled={!e.hasCommits}
                class:list={[
                  "block rounded border p-4",
                  e.hasCommits
                    ? "border-neutral-200 hover:bg-neutral-50 dark:border-neutral-800 dark:hover:bg-neutral-900"
                    : "border-dashed border-neutral-200 text-neutral-400 dark:border-neutral-800 dark:text-neutral-600 cursor-not-allowed",
                ]}
              >
                <div class="flex items-center gap-3">
                  {e.iconSrc ? (
                    <img
                      src={e.iconSrc}
                      alt=""
                      width="20"
                      height="20"
                      loading="lazy"
                      class="h-5 w-5 shrink-0"
                    />
                  ) : (
                    <span
                      class="inline-block h-2 w-2 rounded-full"
                      style={`background-color: ${e.accent_color};`}
                      aria-hidden="true"
                    />
                  )}
                  <span class="font-medium">{e.name}</span>
                  <span class="text-xs text-neutral-500">{e.console}</span>
                  {!e.hasCommits && (
                    <span class="ml-auto text-xs text-neutral-400">no submissions yet</span>
                  )}
                </div>
                <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{e.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
